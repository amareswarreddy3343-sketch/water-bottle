{
  "name": "dentalflow-backend",
  "version": "1.0.0",
  "description": "DentalFlow API — Node.js / Express / MongoDB backend (MERN)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node src/start-production.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/createAdmin.js",
    "migrate:postgres": "node scripts/migrateFromPostgres.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/features.test.js tests/password.test.js tests/clinic.test.js",
    "restore": "node scripts/restore.js",
    "reset-password": "node scripts/resetPassword.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server-core": "^11.3.0",
    "mongoose": "^8.24.5",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  }
}
