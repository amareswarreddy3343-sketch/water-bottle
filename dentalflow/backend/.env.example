# ─────────────────────────────────────────────────────────────
# DentalFlow server (Node.js / Express / MongoDB)
# Everything here is OPTIONAL — the app runs with no .env file at all.
# Copy to backend/.env only if you want to change something.
# ─────────────────────────────────────────────────────────────

# NODE_ENV=production   (set automatically by "npm start" / start.bat / start.sh)
PORT=8000
HOST=0.0.0.0

# Database
#   Leave MONGODB_URI empty → the built-in MongoDB is used (downloaded automatically on the
#   first start, data kept in backend/data/db). Nothing to install.
#   For cloud hosting use a hosted MongoDB, e.g. Railway (MONGODB_URI=${{MongoDB.MONGO_URL}})
#   or MongoDB Atlas:  MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dentalflow
#   (MONGO_URL is also accepted.) Database name used when the address has none:
# MONGODB_DB=dentalflow
MONGODB_URI=
# Built-in database options
# EMBEDDED_DB_PORT=27018
# EMBEDDED_DB_PATH=data/db

# Secret used to sign login tokens. If empty, one is generated automatically and saved
# in backend/data/.jwt-secret. Set it yourself when the data folder is not persistent
# (e.g. cloud hosting), otherwise users are logged out after each redeploy.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First start: if there are no users yet, a Master admin is created automatically
# (password printed in the console and saved in backend/data/initial-admin-password.txt).
# INITIAL_ADMIN_EMAIL=admin@dental.com
# INITIAL_ADMIN_PASSWORD=
# AUTO_CREATE_ADMIN=true

# Token lifetimes (defaults match the old Django settings: 8 hours / 7 days)
# JWT_ACCESS_TTL_SECONDS=28800
# JWT_REFRESH_TTL_SECONDS=604800

# Only needed if the app is hosted on a DIFFERENT domain than this server
# (not needed for the normal single-server setup or the Vite dev server).
# Front-end URLs allowed to call the API (comma-separated, no spaces):
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# LAN access — add your machine's IP:
# CORS_ALLOWED_ORIGINS=http://192.168.x.x:5173,http://localhost:5173
# Production:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Clinic time zone (used for "today": appointments, registered today, default treatment date)
TIME_ZONE=Asia/Kolkata

# Where uploaded reports are stored (relative to backend/, or an absolute path) and the max
# upload size. On Railway, files go to the attached volume automatically.
# MEDIA_ROOT=mediafiles
MAX_UPLOAD_MB=10

# The built React app (frontend/dist) is served from this same server automatically.
# SERVE_FRONTEND=false   ← only if you host the frontend somewhere else
# Behind a reverse proxy (nginx, Caddy …) so uploaded-file links use https.
# Turned on automatically on Railway.
# TRUST_PROXY=true

# Email for "Forgot password?" links — choose ONE (see README → Email for password resets).
# Brevo (free; works with a Gmail sender; works on Railway Hobby):
# BREVO_API_KEY=
# Resend (needs your own domain):
# RESEND_API_KEY=
# Gmail / any SMTP server (clinic PC or VPS; blocked on Railway Hobby):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=icare322025@gmail.com
# SMTP_PASS=your-16-character-app-password
# Sender address (for SMTP defaults to SMTP_USER) and name:
# MAIL_FROM=icare322025@gmail.com
# MAIL_FROM_NAME=iCare 32 Dental Clinic
# Address of the app used in email links (default: Railway domain, else the address used to open the app)
# APP_URL=https://app.icare32.in

# Backups (automatic, once a day, plus before upgrades and restores). Default folder:
# backend/data/backups. Point it outside this computer — a OneDrive / Google Drive folder or
# a USB drive — so a copy survives if the computer fails:
# BACKUP_DIR=C:\Users\Clinic\OneDrive\iCare32-backups
# BACKUP_KEEP=60            (number of backup files kept)
# BACKUP_DISABLED=false

# Testing only: pretend today is another day (e.g. to see appointments "on that day")
# CLINIC_FAKE_TODAY=2026-10-20

# Emergency admin password reset (applied once at start; remove afterwards)
# RESET_PASSWORD_EMAIL=admin@dental.com
# RESET_PASSWORD=

# Login attempts allowed per IP per window
# LOGIN_RATE_LIMIT_MAX=100
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Only for `npm run migrate:postgres` (moving data from the old PostgreSQL database)
# PG_URL=postgres://dentalflow_user:password@localhost:5432/dentalflow
